{
  "name": "node-quality-tp",
  "version": "1.0.0",
  "private": true,
  "description": "Mini-projet API REST To-Do List avec qualité logicielle et CI/CD",
  "main": "src/app.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch src/app.js",
    "start": "node src/app.js",
